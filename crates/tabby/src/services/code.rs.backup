//! Сервис записи событий в файловую систему
//!
//! Обеспечивает асинхронную запись событий в JSON файлы с ротацией по датам.
//! Использует буферизованную запись и автоматический сброс для надежности.

// === IMPORTS ===
use std::{path::PathBuf, time::Duration};

use chrono::Utc;
use lazy_static::lazy_static;
use tokio::{
    io::AsyncWriteExt,
    sync::mpsc::{unbounded_channel, UnboundedSender},
    time::{self},
};
use tracing::error;

use tabby_common::{
    api::event::{EventLogger, LogEntry},
    path,
};

// === CONSTANTS ===
/// Интервал автоматического сброса буфера в секундах
const FLUSH_INTERVAL_SECS: u64 = 5;

// Глобальный отправитель для записи событий в файлы
// 
// Создаёт фоновую задачу, которая принимает события через канал
// и записывает их в файлы, организованные по датам. Автоматически
// сбрасывает буфер каждые 5 секунд для обеспечения сохранности данных.
lazy_static! {
    static ref WRITER: UnboundedSender<String> = {
        let (tx, mut rx) = unbounded_channel::<String>();

        tokio::spawn(async move {
            let mut writer = EventWriter::new(path::events_dir()).await;
            let mut interval = time::interval(Duration::from_secs(FLUSH_INTERVAL_SECS));

            loop {
                tokio::select! {
                    content = rx.recv() => {
                        if let Some(content) = content {
                            writer.write_line(content).await;
                        } else {
                            break;
                        }
                    }
                    _ = interval.tick() => {
                        writer.flush().await;
                    }
                }
            }
        });

        tx
    };
}

// === STRUCTS ===
/// Писатель событий в файлы с ротацией по датам
///
/// Управляет записью событий в JSON файлы, организованные по датам.
/// Автоматически создаёт новые файлы при смене даты и поддерживает
/// буферизованную запись для повышения производительности.
struct EventWriter {
    /// Директория для хранения файлов событий
    events_dir: PathBuf,
    /// Имя текущего файла (формат: YYYY-MM-DD.json)
    filename: Option<String>,
    /// Буферизованный писатель для текущего файла
    writer: Option<tokio::io::BufWriter<tokio::fs::File>>,
}

/// Сервис для записи событий
///
/// Реализует трейт EventLogger для записи событий в файловую систему
/// через глобальный канал. Обеспечивает асинхронную обработку и
/// автоматическую сериализацию событий в JSON формат.
struct EventService;

// === IMPLEMENTATIONS ===
impl EventWriter {
    /// Создаёт новый писатель событий
    ///
    /// # Arguments
    ///
    /// * `events_dir` - Директория для хранения файлов событий
    ///
    /// # Returns
    ///
    /// Новый экземпляр EventWriter с созданной директорией
    async fn new(events_dir: PathBuf) -> Self {
        // Создаём директорию если она не существует
        tokio::fs::create_dir_all(events_dir.as_path()).await.ok();

        Self {
            events_dir,
            filename: None,
            writer: None,
        }
    }

    /// Возвращает путь к текущему файлу событий
    ///
    /// Используется в тестах для проверки корректности записи
    #[cfg(test)]
    fn event_file_path(&self) -> Option<PathBuf> {
        self.filename
            .as_ref()
            .map(|fname| self.events_dir.join(fname))
    }

    /// Записывает строку в файл событий
    ///
    /// Автоматически создаёт новый файл при смене даты.
    /// Использует формат имени файла: YYYY-MM-DD.json
    ///
    /// # Arguments
    ///
    /// * `content` - Содержимое для записи (обычно JSON строка)
    async fn write_line(&mut self, content: String) {
        let now = Utc::now();
        let fname = now.format("%Y-%m-%d.json");

        // Проверяем, нужно ли создать новый файл (смена даты)
        if self.filename != Some(fname.to_string()) {
            // Сбрасываем буфер предыдущего файла
            if let Some(mut w) = self.writer.take() {
                w.flush().await.unwrap();
            }

            // Открываем новый файл для записи
            let file = tokio::fs::OpenOptions::new()
                .create(true)
                .append(true)
                .write(true)
                .open(self.events_dir.join(fname.to_string()))
                .await
                .ok()
                .unwrap();
            
            self.writer = Some(tokio::io::BufWriter::new(file));
            self.filename = Some(fname.to_string());
        }

        // Записываем содержимое с переводом строки
        let writer = self.writer.as_mut().unwrap();
        writer
            .write_all(format!("{content}\n").as_bytes())
            .await
            .unwrap();
    }

    /// Принудительно сбрасывает буфер на диск
    ///
    /// Обеспечивает сохранность данных при периодических сбросах
    /// или завершении работы приложения.
    async fn flush(&mut self) {
        let writer = self.writer.as_mut().unwrap();
        writer.flush().await.unwrap()
    }
}

impl EventLogger for EventService {
    /// Записывает событие в файл
    ///
    /// Сериализует событие в JSON и отправляет через глобальный канал
    /// для асинхронной записи в файл. При ошибках сериализации или
    /// отправки логирует ошибку через tracing.
    ///
    /// # Arguments
    ///
    /// * `x` - Событие для записи
    fn write(&self, x: LogEntry) {
        // Сериализуем событие в JSON
        let json = match serdeconv::to_json_string(&x) {
            Ok(json) => json,
            Err(err) => {
                error!("Failed to serialize event into json {}", err);
                return;
            }
        };

        // Отправляем через канал для асинхронной записи
        if let Err(err) = WRITER.send(json) {
            error!("Failed to write event to file: {}", err);
        }
    }
}

// === FREE FUNCTIONS ===
/// Создаёт новый логгер событий
///
/// Возвращает реализацию EventLogger для записи событий в файловую систему.
/// События записываются асинхронно через глобальный канал с автоматической
/// ротацией файлов по датам.
///
/// # Returns
///
/// Экземпляр EventService, реализующий трейт EventLogger
#[allow(unused)]
pub fn create_event_logger() -> impl EventLogger + 'static {
    EventService
}

// === TESTS ===
#[cfg(test)]
mod tests {
    use super::*;

    /// Возвращает временную директорию для тестов
    fn events_dir() -> PathBuf {
        std::env::temp_dir().join(".tabby").join("events")
    }

    /// Тестирует переключение между файлами при смене даты
    ///
    /// Проверяет, что при записи в EventWriter с уже установленным
    /// старым файлом создаётся новый файл с текущей датой, а старый
    /// файл остаётся неизменным.
    async fn test_event_writer_swap_file() {
        tokio::fs::create_dir_all(events_dir()).await.ok();

        // Создаём старый файл с данными
        let old_fname = "2021-01-01.json".to_string();
        let old_file = tokio::fs::OpenOptions::new()
            .create(true)
            .append(true)
            .write(true)
            .open(events_dir().join(old_fname.clone()))
            .await
            .ok()
            .unwrap();
        
        let mut old_wr = tokio::io::BufWriter::new(old_file);
        old_wr
            .write_all(format!("{}\n", "old data in old file").as_bytes())
            .await
            .unwrap();
        old_wr.flush().await.unwrap();

        // Создаём EventWriter с привязкой к старому файлу
        let mut event_wr = EventWriter {
            events_dir: events_dir(),
            filename: Some(old_fname.clone()),
            writer: Some(old_wr),
        };
        
        // Записываем новые данные (должен создаться новый файл)
        event_wr.write_line("test data".to_string()).await;
        event_wr.flush().await;

        // Проверяем, что новый файл содержит наши данные
        let content = tokio::fs::read_to_string(event_wr.event_file_path().unwrap())
            .await
            .unwrap();
        assert_eq!(content.as_str(), "test data\n");
        
        // Проверяем, что старый файл остался неизменным
        let content = tokio::fs::read_to_string(events_dir().join(old_fname))
            .await
            .unwrap();
        assert_eq!(content.as_str(), "old data in old file\n");
    }

    /// Основной тест функциональности EventWriter
    #[tokio::test]
    async fn test_event_writer() {
        // Очищаем директорию от предыдущих тестов
        tokio::fs::remove_dir_all(events_dir()).await.ok();

        test_event_writer_swap_file().await;
        
        // Очищаем после теста
        tokio::fs::remove_dir_all(events_dir()).await.unwrap();
    }
}
